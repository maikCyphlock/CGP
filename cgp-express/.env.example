# DB_CLIENT selects the swappable connector: "sqlite3" (default, today) or "pg" (postgresql, tomorrow)
DB_CLIENT=sqlite3
SQLITE_FILE=./data/contraloria.sqlite3

# Only needed when DB_CLIENT=pg
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=contraloria
PG_USER=postgres
PG_PASSWORD=postgres

SESSION_SECRET=change-me-in-production
PORT=3000
