<div class="modal-backdrop" @click.self="null" id="catalog-modal">
  <div class="modal-box">
    <h2><%= row ? 'Editar' : 'Nuevo' %> — <%= catalog.label %></h2>
    <form
      hx-post="/admin/catalogs/<%= slug %><%= row ? '/' + row.id : '' %>"
      hx-target="#catalog-table"
      hx-swap="innerHTML"
      hx-on::after-request="if(event.detail.successful) document.getElementById('modal-container').innerHTML=''">

      <% catalog.fields.forEach(function(f) { %>
        <div class="form-group">
          <label><%= f.label %><% if (f.required) { %> *<% } %></label>

          <% if (f.type === 'select') { %>
            <select name="<%= f.name %>" <%= f.required ? 'required' : '' %>>
              <% f.options.forEach(function(opt) { %>
                <option value="<%= opt %>" <%= row && row[f.name] === opt ? 'selected' : '' %>><%= opt %></option>
              <% }) %>
            </select>

          <% } else if (f.type === 'textarea') { %>
            <textarea name="<%= f.name %>"><%= row ? row[f.name] : '' %></textarea>

          <% } else if (f.type === 'json') { %>
            <textarea name="<%= f.name %>"><%= row ? JSON.stringify(JSON.parse(row[f.name] || '[]'), null, 2) : '[]' %></textarea>

          <% } else if (f.type === 'checkbox') { %>
            <div class="checkbox-row">
              <input type="checkbox" name="<%= f.name %>" <%= (!row || row[f.name]) ? 'checked' : '' %>>
            </div>

          <% } else { %>
            <input type="<%= f.type %>" name="<%= f.name %>" value="<%= row ? row[f.name] : '' %>" <%= f.required ? 'required' : '' %>>
          <% } %>
        </div>
      <% }) %>

      <div class="form-actions">
        <button type="button" class="btn btn-outline" onclick="document.getElementById('modal-container').innerHTML=''">Cancelar</button>
        <button type="submit" class="btn">Guardar</button>
      </div>
    </form>
  </div>
</div>
