<%- include('../partials/admin_head', { title, active: 'users' }) %>
<div class="admin-topbar"><h1>Nuevo Usuario de Personal</h1></div>
<div class="card" style="max-width:560px;">
  <% if (error) { %><div class="login-alert"><%= error %></div><% } %>
  <form method="POST" action="/admin/users">
    <div class="form-row">
      <div class="form-group"><label>Primer nombre *</label><input type="text" name="first_name" required></div>
      <div class="form-group"><label>Primer apellido *</label><input type="text" name="last_name" required></div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label>Tipo doc. *</label>
        <select name="id_doc_type_id" required>
          <% docTypes.forEach(function(d) { %><option value="<%= d.id %>"><%= d.name %></option><% }) %>
        </select>
      </div>
      <div class="form-group"><label>N° documento *</label><input type="text" name="id_doc_number" required></div>
      <div class="form-group">
        <label>Sexo *</label>
        <select name="sex" required><option value="M">M</option><option value="F">F</option></select>
      </div>
    </div>
    <div class="form-group">
      <label>Cargo *</label>
      <select name="job_position_id" required>
        <% jobPositions.forEach(function(j) { %><option value="<%= j.id %>"><%= j.title %></option><% }) %>
      </select>
    </div>
    <div class="form-row">
      <div class="form-group"><label>Correo institucional *</label><input type="email" name="email" required></div>
      <div class="form-group"><label>Teléfono móvil *</label><input type="text" name="mobile_phone" required></div>
    </div>
    <div class="form-group"><label>Contraseña *</label><input type="password" name="password" required minlength="8"></div>
    <div class="form-actions">
      <a class="btn btn-outline" href="/admin/users">Cancelar</a>
      <button class="btn" type="submit">Crear usuario</button>
    </div>
  </form>
</div>
<%- include('../partials/admin_foot') %>
