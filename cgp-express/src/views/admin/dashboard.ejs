<%- include('../partials/admin_head', { title, active: 'dashboard' }) %>
<div class="admin-topbar">
  <h1>Panel Administrativo</h1>
</div>

<div class="stat-strip">
  <div>
    <div class="stat-label">Expedientes totales</div>
    <div class="stat-value"><%= stats.totalCases %></div>
  </div>
  <div>
    <div class="stat-label">Recibidos sin revisar</div>
    <div class="stat-value <%= Number(stats.received) > 0 ? 'accent' : '' %>"><%= stats.received %></div>
  </div>
  <div>
    <div class="stat-label">Personal activo</div>
    <div class="stat-value"><%= stats.activeStaff %></div>
  </div>
</div>

<div class="card" style="padding: 8px 24px;">
  <div class="module-nav">
    <a href="/admin/cases">
      <div class="module-nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a1 1 0 0 1 1-1h4.5l1.5 2H20a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7Z"/></svg></div>
      <div class="module-nav-text"><strong>Gestión de Expedientes</strong><span>Recibir, clasificar y derivar denuncias, quejas y reclamos</span></div>
      <svg class="module-nav-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
    </a>
    <a href="/admin/catalogs">
      <div class="module-nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 8.5 4.5L12 12 3.5 7.5 12 3Z"/><path d="m3.5 12.5 8.5 4.5 8.5-4.5"/><path d="m3.5 16.5 8.5 4.5 8.5-4.5"/></svg></div>
      <div class="module-nav-text"><strong>Gestión de Catálogos</strong><span>Tipos de trámite, irregularidades, estados y demás listas maestras</span></div>
      <svg class="module-nav-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
    </a>
    <a href="/admin/users">
      <div class="module-nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 5.5V11c0 4.5 3 8 7 9.5 4-1.5 7-5 7-9.5V5.5L12 3Z"/><path d="m9.5 12 1.8 1.8 3.2-3.6"/></svg></div>
      <div class="module-nav-text"><strong>Usuarios y Accesos</strong><span>Personal interno y privilegios por módulo (RBAC)</span></div>
      <svg class="module-nav-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
    </a>
    <a href="/admin/cms">
      <div class="module-nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h7l4 4v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><path d="M14 3v4h4"/><path d="M9 13h6M9 17h6"/></svg></div>
      <div class="module-nav-text"><strong>Página Web (CMS)</strong><span>Noticias, misión/visión y contenido publicado en el portal</span></div>
      <svg class="module-nav-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
    </a>
  </div>
</div>

<%- include('../partials/admin_foot') %>
