<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · Admin Contraloría Páez</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/htmx.org@1.9.12"></script>
  <script src="https://unpkg.com/alpinejs@3.14.1/dist/cdn.min.js" defer></script>
  <link rel="stylesheet" href="/admin.css">
</head>
<body>
<% var nav = [
  { key: 'dashboard', href: '/admin', label: 'Inicio', icon: 'home' },
  { key: 'cases', href: '/admin/cases', label: 'Expedientes', icon: 'folder' },
  { key: 'catalogs', href: '/admin/catalogs', label: 'Catálogos', icon: 'layers' },
  { key: 'users', href: '/admin/users', label: 'Usuarios y Accesos', icon: 'shield' },
  { key: 'cms', href: '/admin/cms', label: 'Página Web (CMS)', icon: 'file-text' },
]; %>
<% var icons = {
  home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V20a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9.5"/>',
  folder: '<path d="M3 7a1 1 0 0 1 1-1h4.5l1.5 2H20a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7Z"/>',
  layers: '<path d="m12 3 8.5 4.5L12 12 3.5 7.5 12 3Z"/><path d="m3.5 12.5 8.5 4.5 8.5-4.5"/><path d="m3.5 16.5 8.5 4.5 8.5-4.5"/>',
  shield: '<path d="M12 3 5 5.5V11c0 4.5 3 8 7 9.5 4-1.5 7-5 7-9.5V5.5L12 3Z"/><path d="m9.5 12 1.8 1.8 3.2-3.6"/>',
  'file-text': '<path d="M7 3h7l4 4v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><path d="M14 3v4h4"/><path d="M9 13h6M9 17h6"/>',
}; %>
<div class="admin-shell">
  <aside class="admin-sidebar">
    <div class="admin-brand">
      <img src="/assets/img/logo.jpeg" alt="">
      <div class="admin-brand-text">
        <strong>Contraloría</strong>
        <span>Municipio Páez</span>
      </div>
    </div>
    <nav>
      <% nav.forEach(function(item) { %>
        <a href="<%= item.href %>" class="<%= typeof active !== 'undefined' && active === item.key ? 'active' : '' %>">
          <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><%- icons[item.icon] %></svg>
          <span><%= item.label %></span>
        </a>
      <% }) %>
    </nav>
    <form action="/admin/logout" method="POST" class="admin-logout">
      <div class="admin-logout-user">
        <div class="chatter-avatar" style="background:<%= avatarColor(staffUser ? staffUser.name : 'Sistema') %>"><%= initials(staffUser ? staffUser.name : '?') %></div>
        <span><%= staffUser ? staffUser.name : '' %></span>
      </div>
      <button type="submit" title="Cerrar sesión">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
      </button>
    </form>
  </aside>
  <main class="admin-main">
